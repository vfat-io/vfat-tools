
# Bind only locally (nginx will reverse-proxy to it)
HOST=127.0.0.1
PORT=8787

# Etherscan v2 API key 
ETHERSCAN_API_KEY=
SNOWTRACE_API_KEY=

# Upstream for /api/positions. Leave unset to disable that endpoint (501).
# Must accept ?addresses=0x... and return position rows carrying nft.id and
# nft.managerAddress.
POSITIONS_API_URL=
POSITIONS_API_KEY=

