<%
    const meta = locals.pageMeta || {}
    const title = meta.title || 'Yield Farming Info'
    const description = meta.description || '🧑‍🌾 It ain\'t much, but it\'s honest work'
    const url = meta.url || 'https://vfat.tools/'
    const image = meta.image || 'https://yieldfarming.info/img/thumbnail.png'
    const imageAlt = meta.imageAlt || 'Yield Farming Info'
%>
<head>
    <meta charset="UTF-8">
    <!-- Primary Meta Tags -->
    <title><%= title %></title>
    <meta name="title" content="<%= title %>">
    <meta name="description" content="<%= description %>">
    <% if (meta.url) { %>
        <link rel="canonical" href="<%= url %>">
    <% } %>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= url %>">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:image" content="<%= image %>">
    <meta property="og:image:alt" content="<%= imageAlt %>">
    <% if (meta.imageWidth && meta.imageHeight) { %>
        <meta property="og:image:width" content="<%= meta.imageWidth %>">
        <meta property="og:image:height" content="<%= meta.imageHeight %>">
    <% } %>

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= url %>">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="<%= image %>">
    <meta name="twitter:image:alt" content="<%= imageAlt %>">

    <% if(filenameMap) { %>
        <link rel="stylesheet" href="<%= PP %>/css/<%= filenameMap['index.css'] %>">
        <% if (!locals.noGlobalScripts) { %>
            <link rel="preload" href="<%= PP %>/js/<%= filenameMap['vendor.js'] %>" as="script">
            <link rel="prefetch" href="<%= PP %>/js/<%= filenameMap['vendor.js'] %>">
            <link rel="preload" href="<%= PP %>/js/<%= filenameMap['app.js'] %>" as="script">
            <link rel="prefetch" href="<%= PP %>/js/<%= filenameMap['app.js'] %>">
        <% } %>
    <% } else { %>
        <link rel="stylesheet" href="<%= PP %>/css/index.css">
        <% if (!locals.noGlobalScripts) { %>
            <link rel="preload" href="<%= PP %>/js/vendor.js" as="script">
            <link rel="prefetch" href="<%= PP %>/js/vendor.js">
            <link rel="preload" href="<%= PP %>/js/app.js" as="script">
            <link rel="prefetch" href="<%= PP %>/js/app.js">
        <% } %>
    <% } %>

    <meta name="theme-color" content="#ffffff">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="<%= PP %>/favicon.svg">
    <link rel="apple-touch-icon" href="<%= PP %>/apple-touch-icon.png">
    <link rel="manifest" href="<%= PP %>/manifest.json">
</head>
<%- include(`${partials}/quick`); -%>
<%- include(`${partials}/pool_details_modal`); -%>
