<!DOCTYPE html>
<html lang="en">
<%- include(`${partials}/head`, {
  noGlobalScripts: true,
  pageMeta: {
    title: 'GIGA Farms on Robinhood Chain | vfat.tools',
    description: 'GIGA farms, onchain APRs, and direct wallet actions on Robinhood Chain.',
    url: 'https://vfat.tools/robinhood/giga/',
    image: 'https://vfat.tools/img/robinhood-giga-social.png',
    imageAlt: 'vfat.tools GIGA farm table on Robinhood Chain.',
    imageWidth: 1200,
    imageHeight: 630
  }
}); -%>
<body>
<%- include(`${partials}/header_main`); -%>
<main class="giga-page">
<nav class="giga-mobile-nav" aria-label="GIGA page navigation"><a href="../">[ Robinhood farms ]</a> <a href="/">[ vfat.tools ]</a></nav>
<div class="giga-toolbar"><span id="giga-wallet-status"></span> <button id="giga-connect" class="giga-link" type="button">[ connect ]</button> <button id="giga-other-wallet" class="giga-link" type="button">[ other wallet ]</button> <button id="giga-zero-toggle" class="giga-link" type="button">[ show inactive ]</button> <button id="giga-refresh" class="giga-link" type="button">[ refresh ]</button></div>
<p id="giga-status" class="giga-status" role="status" hidden></p>
<div id="giga-loading" class="giga-loading" role="status" aria-live="polite"><span id="giga-loading-spin">[....]</span></div>
<p id="giga-price" class="giga-price">GIGA —</p>
<div id="giga-farms" class="giga-table-wrap" aria-live="polite"></div>
<div id="giga-positions" class="giga-table-wrap giga-positions" aria-live="polite" hidden></div>
</main>
<dialog id="giga-action-dialog" class="giga-dialog" aria-labelledby="giga-action-title"><form method="dialog" class="giga-close"><button type="submit">[ close ]</button></form><div id="giga-action-content"></div></dialog>
<style>
.giga-page{max-width:1500px;margin:20px 10px 50px;min-width:0}.giga-page,.giga-page *{box-sizing:border-box;font-family:monospace}.giga-mobile-nav{display:none}.giga-toolbar,.giga-price,.giga-status{margin:0 0 14px;font:14px/1.45 monospace;text-align:left}.giga-status[data-kind="error"]{color:#d95757}.giga-status[data-kind="success"]{color:var(--highlight-color)}.giga-link,.giga-action,.giga-dialog button{margin:0;padding:0;border:0;background:transparent;color:inherit;cursor:pointer;font:inherit;text-decoration:underline}.giga-link:hover,.giga-action:hover,.giga-dialog button:hover{color:var(--highlight-color)}.giga-link:disabled,.giga-action:disabled,.giga-dialog button:disabled{cursor:not-allowed;opacity:.45;text-decoration:none}.giga-loading{padding:0 0 14px}.giga-loading[hidden]{display:none}.giga-table-wrap{width:100%;min-width:0;overflow-x:auto}.giga-positions{margin-top:26px}.giga-table{width:100%;min-width:1120px;table-layout:fixed;border-collapse:collapse;font-size:13px}.giga-table td,.giga-table th{padding:7px 8px;border:1px solid currentColor;vertical-align:top;text-align:right;white-space:pre-line;overflow-wrap:anywhere}.giga-table th{white-space:normal}.giga-table td:first-child,.giga-table th:first-child,.giga-table td:last-child,.giga-table th:last-child{text-align:left}.giga-name,.giga-sub{display:block;max-width:240px;white-space:normal;overflow-wrap:anywhere}.giga-sub{margin-top:3px;color:var(--highlight-color);font-size:12px}.giga-actions{min-width:135px;white-space:normal!important}.giga-actions>*{display:inline-block;margin:0 8px 5px 0;white-space:nowrap}.giga-unpriced{opacity:.7}.giga-dialog{width:min(660px,calc(100vw - 28px));max-width:calc(100vw - 28px);padding:16px;border:1px solid currentColor;background:var(--main-background-color);color:var(--main-text-color)}.giga-dialog::backdrop{background:rgba(0,0,0,.55)}.giga-close{margin:0 0 18px;text-align:right}.giga-dialog h2{margin:0 0 8px;padding:0;border:0;color:inherit;font:bold 16px/1.4 monospace;text-align:left}.giga-dialog p{margin:0 0 12px;font:14px/1.45 monospace;text-align:left;overflow-wrap:anywhere}.giga-input{display:flex;gap:10px;align-items:center;margin:8px 0}.giga-input input{width:100%;min-width:0;padding:5px 7px;border:1px solid currentColor;border-radius:0;background:transparent;color:inherit;font:16px/1.4 monospace}.giga-dialog-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:14px}@media(max-width:700px){body>div:not(.modal){display:none}.giga-page{margin:14px 8px 40px;overflow-x:hidden}.giga-mobile-nav{display:block;margin-bottom:14px}.giga-toolbar,.giga-price{font-size:12px}.giga-table-wrap{overflow:visible}.giga-table{min-width:0;font-size:12px}.giga-table td,.giga-table th{padding:6px}.giga-table th:nth-child(3),.giga-table td:nth-child(3),.giga-table th:nth-child(5),.giga-table td:nth-child(5){display:none}.giga-table th:first-child{width:35%}.giga-table th:nth-child(2){width:20%}.giga-table th:nth-child(4){width:18%}.giga-table th:last-child{width:27%}.giga-name,.giga-sub{max-width:none}.giga-actions{min-width:0}.giga-actions>*{margin-right:6px}}
</style>
<% if (filenameMap && filenameMap['robinhood_giga.js']) { -%>
<script src="<%= PP %>/js/<%= filenameMap['robinhood_giga.js'] %>"></script>
<% } else { -%>
<script src="<%= PP %>/js/robinhood_giga.js"></script>
<% } -%>
</body>
</html>
