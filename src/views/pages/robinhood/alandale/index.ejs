<!DOCTYPE html>
<html lang="en">
<%- include(`${partials}/head`, {
  noGlobalScripts: true,
  pageMeta: {
    title: 'Alandale Farms on Robinhood Chain | vfat.tools',
    description: 'Alandale farms, LUTE emissions, APRs, rewards, and direct wallet actions on Robinhood Chain.',
    url: 'https://vfat.tools/robinhood/alandale/',
    image: 'https://vfat.tools/img/robinhood-alandale-social.png',
    imageAlt: 'Live vfat.tools Alandale farm table on Robinhood Chain.',
    imageWidth: 1200,
    imageHeight: 630
  }
}); -%>

<body>
<%- include(`${partials}/header_main`); -%>
<main class="alandale-page">
<nav class="alandale-mobile-nav" aria-label="Alandale page navigation">
  <a href="../">[ Robinhood farms ]</a> <a href="/">[ vfat.tools ]</a>
</nav>
<div class="alandale-toolbar"><span id="alandale-wallet-status"></span> <button id="alandale-connect" class="alandale-link-button" type="button">[ connect ]</button> <button id="alandale-other-wallet" class="alandale-link-button" type="button">[ other wallet ]</button> <button id="alandale-zero-apr-toggle" class="alandale-link-button" type="button">[ show inactive ]</button> <a href="https://app.alandale.xyz" target="_blank" rel="noopener noreferrer">[ app ]</a></div>
<p id="alandale-status" class="alandale-status" role="status" hidden></p>
<p id="alandale-overview" class="alandale-summary" aria-live="polite" hidden></p>

<div id="alandale-loading" class="alandale-loading" role="status" aria-live="polite">
  <span class="loader--1" aria-hidden="true"></span> <span id="alandale-loading-text">Reading Alandale farms…</span>
</div>

<section class="alandale-farms-section">
  <div class="alandale-table-scroll"><div id="alandale-farms" aria-live="polite"></div></div>
</section>

<section id="alandale-positions-section" class="alandale-farms-section" hidden>
  <div class="alandale-table-scroll"><div id="alandale-positions" aria-live="polite"></div></div>
</section>
</main>

<dialog id="alandale-action-dialog" class="alandale-action-dialog" aria-labelledby="alandale-action-title">
  <form method="dialog" class="alandale-dialog-close-row"><button type="submit">[ close ]</button></form>
  <div id="alandale-action-content"></div>
</dialog>

<style>
  .alandale-page { margin: 20px 10px 50px; max-width: 1440px; }
  .alandale-page, .alandale-page * { font-family: monospace; }
  .alandale-mobile-nav { display: none; }
  .alandale-toolbar, .alandale-summary, .alandale-status { margin: 0 0 14px; overflow-wrap: anywhere; font: 14px/1.45 monospace; text-align: left; }
  .alandale-status { color: #d95757; }
  .alandale-status[data-kind="success"] { color: var(--highlight-color); }
  .alandale-note { max-width: none; margin: 0 0 18px; color: inherit; font: 14px/1.45 monospace; text-align: left; }
  .alandale-link-button, .alandale-action-button, .alandale-action-dialog button { margin: 0; padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; font: inherit; text-decoration: underline; }
  .alandale-link-button:hover, .alandale-action-button:hover, .alandale-action-dialog button:hover { color: var(--highlight-color); }
  .alandale-link-button:disabled, .alandale-action-button:disabled, .alandale-action-dialog button:disabled { cursor: not-allowed; opacity: .45; text-decoration: none; }
  .alandale-loading { padding: 10px 0; }
  .alandale-loading[hidden] { display: none; }
  .alandale-table-scroll { overflow-x: auto; }
  .alandale-farm-table { width: 100%; min-width: 940px; table-layout: fixed; border-collapse: collapse; font-size: 13px; }
  .alandale-farm-table th, .alandale-farm-table td { padding: 7px 9px; border: 1px solid currentColor; vertical-align: top; text-align: right; white-space: nowrap; }
  .alandale-farm-table th:first-child, .alandale-farm-table td:first-child, .alandale-farm-table th:last-child, .alandale-farm-table td:last-child { text-align: left; }
  .alandale-farm-table .alandale-pair { display: block; overflow-wrap: anywhere; white-space: normal; }
  .alandale-farm-table .alandale-kind { display: block; margin-top: 3px; color: var(--highlight-color); }
  .alandale-farm-table .alandale-values span { display: block; }
  .alandale-farm-table .alandale-values span + span { margin-top: 3px; }
  .alandale-farm-table .alandale-actions { min-width: 102px; white-space: normal; }
  .alandale-farm-table .alandale-actions > * { display: block; }
  .alandale-farm-table .alandale-actions > * + * { margin-top: 4px; }
  .alandale-action-dialog { width: min(590px, calc(100vw - 32px)); padding: 16px; border: 1px solid currentColor; background: var(--main-background-color); color: var(--main-text-color); }
  .alandale-action-dialog::backdrop { background: rgba(0, 0, 0, .55); }
  .alandale-dialog-close-row { margin: 0 0 18px; text-align: right; }
  .alandale-action-dialog h2 { max-width: none; margin: 0 0 8px; padding: 0; border: 0; color: inherit; font: bold 16px/1.4 monospace; text-align: left; }
  .alandale-action-dialog p { margin: 0 0 14px; color: inherit; font: 14px/1.5 monospace; text-align: left; }
  .alandale-action-balance { display: flex; justify-content: space-between; gap: 16px; margin: 12px 0 6px; font: 14px/1.4 monospace; }
  .alandale-form-label { display: block; margin: 10px 0 5px; font: 13px/1.4 monospace; }
  .alandale-input-row { display: flex; }
  .alandale-input-row input { width: 100%; min-width: 0; padding: 5px 7px; border: 1px solid currentColor; border-radius: 0; background: transparent; color: inherit; font: 16px/1.4 monospace; }
  .alandale-input-row button { margin-left: 10px; white-space: nowrap; }
  .alandale-action-note { min-height: 40px; margin: 12px 0; font: 13px/1.45 monospace; white-space: pre-wrap; }
  .alandale-dialog-actions { display: flex; flex-wrap: wrap; gap: 16px; }
  @media (max-width: 600px) {
    html, body { min-width: 0; max-width: 100%; overflow-x: hidden; }
    body > div:not(.modal) { display: none; }
    .alandale-page { box-sizing: border-box; width: calc(100% - 16px); max-width: none; margin: 14px 8px 40px; overflow-x: hidden; }
    .alandale-mobile-nav { display: block; margin-bottom: 14px; }
    .alandale-toolbar, .alandale-summary { font-size: 12px; }
    .alandale-table-scroll { overflow: visible; }
    .alandale-farm-table { min-width: 0; table-layout: fixed; font-size: 13px; }
    .alandale-farm-table th, .alandale-farm-table td { padding: 7px; }
    .alandale-farm-table th { white-space: normal; }
    .alandale-farm-table th:nth-child(3), .alandale-farm-table td:nth-child(3), .alandale-farm-table th:nth-child(5), .alandale-farm-table td:nth-child(5) { display: none; }
    .alandale-farm-table th:nth-child(1) { width: 35%; }
    .alandale-farm-table th:nth-child(2) { width: 20%; }
    .alandale-farm-table th:nth-child(4) { width: 18%; }
    .alandale-farm-table th:nth-child(6) { width: 27%; }
    .alandale-farm-table td:first-child { white-space: normal; overflow-wrap: anywhere; }
    .alandale-farm-table .alandale-actions { min-width: 0; }
  }
</style>
<%- include(`${partials}/scripts_onchain`, {scriptname: 'robinhood_alandale'}); -%>
</body>
</html>
