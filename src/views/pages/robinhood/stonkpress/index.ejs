<!DOCTYPE html>
<html lang="en">
<%- include(`${partials}/head`, {
  noGlobalScripts: true,
  pageMeta: {
    title: 'StonkPress Farms on Robinhood Chain | vfat.tools',
    description: 'StonkPress Genesis and oPLATE farm TVL, APRs, deposit fees, and direct wallet actions on Robinhood Chain.',
    url: 'https://vfat.tools/robinhood/stonkpress/',
    image: 'https://vfat.tools/img/robinhood-social-v2.png',
    imageAlt: 'vfat.tools Robinhood Chain protocol list.',
    imageWidth: 1200,
    imageHeight: 630
  }
}); -%>
<script>if (/\bsocial=1\b/.test(location.search)) document.documentElement.dataset.socialCard = '1'</script>
<body>
<%- include(`${partials}/header_main`); -%>
<main class="stonk-page">
<nav class="stonk-mobile-nav" aria-label="StonkPress page navigation"><a href="../">[ Robinhood farms ]</a> <a href="/">[ vfat.tools ]</a> <a href="https://www.stonk.press/" target="_blank" rel="noopener noreferrer">[ stonk.press ]</a></nav>
<pre id="stonk-banner">
************* 👨‍🌾 UNOFFICIAL STONKPRESS FARM CALCULATOR 👨‍🌾 *************
APP   : <a href="https://www.stonk.press" target="_blank" rel="noopener noreferrer">stonk.press</a>
CHAIN : Robinhood Chain (4663)
MODE  : Onchain RPC + direct wallet
NOTE  : Genesis pays PAPER for a fixed window. The farm pays oPLATE, which
        is exercised into PLATE by paying SPY. PAPER targets 0.0001 SPY.
**********************************************************************
</pre>
<div class="stonk-toolbar"><span id="stonk-wallet-status"></span> <button id="stonk-connect" class="stonk-link" type="button">[ connect ]</button> <button id="stonk-other-wallet" class="stonk-link" type="button">[ other wallet ]</button> <button id="stonk-zero-toggle" class="stonk-link" type="button">[ show ended ]</button> <button id="stonk-refresh" class="stonk-link" type="button">[ refresh ]</button></div>
<p id="stonk-status" class="stonk-status" role="status" hidden></p>
<div id="stonk-loading" class="stonk-loading" role="status" aria-live="polite"><span id="stonk-loading-spin">[....]</span></div>
<p id="stonk-summary" class="stonk-summary"></p>
<div id="stonk-farms" class="stonk-table-wrap" aria-live="polite"></div>
<div id="stonk-positions" class="stonk-table-wrap stonk-positions" aria-live="polite" hidden></div>
<pre class="stonk-footer"><%- include(`${partials}/disclaimer`); -%></pre>
</main>
<dialog id="stonk-action-dialog" class="stonk-dialog" aria-labelledby="stonk-action-title"><form method="dialog" class="stonk-close"><button type="submit">[ close ]</button></form><div id="stonk-action-content"></div></dialog>
<style>
html[data-social-card] body>*:not(main){display:none!important}html[data-social-card] .stonk-footer,html[data-social-card] .stonk-mobile-nav,html[data-social-card] .stonk-toolbar{display:none!important}html[data-social-card] #stonk-loading{display:none!important}html[data-social-card] .stonk-page{margin:14px 16px 0;max-width:none}html[data-social-card] #stonk-banner{font-size:10.5px;line-height:1.22;margin-bottom:8px}html[data-social-card] .stonk-summary{margin-bottom:8px;font-size:13px}html[data-social-card] .stonk-table{font-size:11.5px;min-width:0}html[data-social-card] .stonk-table .stonk-actions,html[data-social-card] .stonk-table th:last-child,html[data-social-card] .stonk-table td:last-child{display:none}html[data-social-card] .stonk-table th:nth-child(5),html[data-social-card] .stonk-table td:nth-child(5){display:none}
.stonk-page{max-width:1500px;margin:20px 10px 50px;min-width:0}.stonk-page,.stonk-page *{box-sizing:border-box;font-family:monospace}#stonk-banner{margin:0 0 14px;font-size:13px;line-height:1.35;white-space:pre-wrap;overflow-wrap:anywhere}.stonk-mobile-nav{display:none;margin-bottom:14px}.stonk-toolbar,.stonk-summary,.stonk-status{margin:0 0 14px;font:14px/1.45 monospace;text-align:left}.stonk-summary{white-space:pre-line}.stonk-status[data-kind="error"]{color:#d95757}.stonk-status[data-kind="success"]{color:var(--highlight-color)}.stonk-link,.stonk-action,.stonk-dialog button{margin:0;padding:0;border:0;background:transparent;color:inherit;cursor:pointer;font:inherit;text-decoration:underline}.stonk-link:hover,.stonk-action:hover,.stonk-dialog button:hover{color:var(--highlight-color)}.stonk-link:disabled,.stonk-action:disabled,.stonk-dialog button:disabled{cursor:not-allowed;opacity:.45;text-decoration:none}.stonk-loading{padding:0 0 14px}.stonk-loading[hidden]{display:none}.stonk-table-wrap{width:100%;min-width:0;overflow-x:auto}.stonk-positions{margin-top:26px}.stonk-table{width:100%;min-width:1080px;table-layout:fixed;border-collapse:collapse;font-size:13px}.stonk-table td,.stonk-table th{padding:7px 8px;border:1px solid currentColor;vertical-align:top;text-align:right;white-space:pre-line;overflow-wrap:anywhere}.stonk-table th{white-space:normal}.stonk-table td:first-child,.stonk-table th:first-child,.stonk-table td:last-child,.stonk-table th:last-child{text-align:left}.stonk-name,.stonk-sub{display:block;max-width:220px;white-space:normal;overflow-wrap:anywhere}.stonk-sub{margin-top:3px;color:var(--highlight-color);font-size:12px}.stonk-actions{min-width:150px;white-space:normal!important}.stonk-actions>*{display:inline-block;margin:0 8px 5px 0;white-space:nowrap}.stonk-unpriced{opacity:.7}.stonk-dialog{width:min(660px,calc(100vw - 28px));max-width:calc(100vw - 28px);padding:16px;border:1px solid currentColor;background:var(--main-background-color);color:var(--main-text-color)}.stonk-dialog::backdrop{background:rgba(0,0,0,.55)}.stonk-close{margin:0 0 18px;text-align:right}.stonk-dialog h2{margin:0 0 8px;padding:0;border:0;color:inherit;font:bold 16px/1.4 monospace;text-align:left}.stonk-dialog p{margin:0 0 12px;font:14px/1.45 monospace;text-align:left;overflow-wrap:anywhere}.stonk-input{display:flex;gap:10px;align-items:center;margin:8px 0}.stonk-input input{width:100%;min-width:0;padding:5px 7px;border:1px solid currentColor;border-radius:0;background:transparent;color:inherit;font:16px/1.4 monospace}.stonk-dialog-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:14px}.stonk-footer{margin-top:24px;white-space:pre-wrap}@media(max-width:700px){body>div:not(.modal){display:none}.stonk-page{margin:14px 8px 40px;overflow-x:hidden}.stonk-mobile-nav{display:block}.stonk-toolbar,.stonk-summary,#stonk-banner{font-size:12px}.stonk-table-wrap{overflow:visible}.stonk-table{min-width:0;font-size:12px}.stonk-table td,.stonk-table th{padding:6px}.stonk-table th:nth-child(3),.stonk-table td:nth-child(3),.stonk-table th:nth-child(5),.stonk-table td:nth-child(5){display:none}.stonk-table th:first-child{width:34%}.stonk-table th:nth-child(2){width:22%}.stonk-table th:nth-child(4){width:18%}.stonk-table th:last-child{width:26%}.stonk-name,.stonk-sub{max-width:none}.stonk-actions{min-width:0}.stonk-actions>*{margin-right:6px}}
</style>
<% if (filenameMap && filenameMap['robinhood_stonkpress.js']) { -%>
<script src="<%= PP %>/js/<%= filenameMap['robinhood_stonkpress.js'] %>"></script>
<% } else { -%>
<script src="<%= PP %>/js/robinhood_stonkpress.js"></script>
<% } -%>
</body>
</html>
