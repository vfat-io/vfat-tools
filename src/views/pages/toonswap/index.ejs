<!DOCTYPE html>
<html lang="en">
<%- include(`${partials}/head`, {
  noGlobalScripts: true,
  pageMeta: {
    title: 'ToonSwap Farms on Ethereum | vfat.tools',
    description: 'ToonSwap farms, pool TVL, TOON rewards, and direct wallet actions on Ethereum.',
    url: 'https://vfat.tools/toonswap/',
    image: 'https://vfat.tools/img/toonswap-social.png',
    imageAlt: 'vfat.tools ToonSwap farms on Ethereum.',
    imageWidth: 1200,
    imageHeight: 630
  }
}); -%>
<body>
<%- include(`${partials}/header_main`); -%>
<main class="toon-page">
<nav class="toon-mobile-nav" aria-label="ToonSwap page navigation"><a href="/">[ vfat.tools ]</a> <a href="https://toonswap.xyz/farms" target="_blank" rel="noopener noreferrer">[ ToonSwap ]</a></nav>
<pre class="toon-banner">******************** 👨‍🌾 UNOFFICIAL TOONSWAP CALCULATOR 👨‍🌾 ********************
CHAIN : Ethereum (1)
MODE  : Onchain RPC + direct wallet
********************************************************************************</pre>
<div class="toon-toolbar"><span id="toon-wallet-status"></span> <button id="toon-connect" class="toon-link" type="button">[ connect ]</button> <button id="toon-other-wallet" class="toon-link" type="button">[ other wallet ]</button> <button id="toon-switch" class="toon-link" type="button" hidden>[ switch to Ethereum ]</button> <button id="toon-zero-toggle" class="toon-link" type="button">[ show inactive ]</button> <button id="toon-refresh" class="toon-link" type="button">[ refresh ]</button></div>
<pre id="toon-overview" class="toon-summary" aria-live="polite">BLOCK    : —
TOON     : —
SUPRA    : —
REWARDS  : —
FARMS    : —</pre>
<p id="toon-status" class="toon-status" role="status" hidden></p>
<div id="toon-loading" class="toon-loading" role="status" aria-live="polite"><span id="toon-loading-spin">[....]</span> <span id="toon-loading-text">Reading ToonSwap farms…</span></div>
<div id="toon-farms" class="toon-table-wrap" aria-live="polite"></div>
<div id="toon-positions" class="toon-table-wrap toon-positions" aria-live="polite" hidden></div>
</main>
<dialog id="toon-action-dialog" class="toon-dialog" aria-labelledby="toon-action-title"><form method="dialog" class="toon-close"><button type="submit">[ close ]</button></form><div id="toon-action-content"></div></dialog>
<style>
.toon-page{max-width:1500px;margin:20px 10px 50px;min-width:0}.toon-page,.toon-page *{box-sizing:border-box;font-family:monospace}.toon-mobile-nav{display:none}.toon-banner,.toon-summary{white-space:pre-wrap;overflow-wrap:anywhere;max-width:100%;margin:0 0 14px;font:14px/1.45 monospace}.toon-toolbar,.toon-status{margin:0 0 14px;font:14px/1.45 monospace;text-align:left}.toon-status[data-kind="error"]{color:#d95757}.toon-status[data-kind="success"]{color:var(--highlight-color)}.toon-link,.toon-action,.toon-dialog button{margin:0;padding:0;border:0;background:transparent;color:inherit;cursor:pointer;font:inherit;text-decoration:underline}.toon-link:hover,.toon-action:hover,.toon-dialog button:hover{color:var(--highlight-color)}.toon-link:disabled,.toon-action:disabled,.toon-dialog button:disabled{cursor:not-allowed;opacity:.45;text-decoration:none}.toon-loading{padding:0 0 14px}.toon-loading[hidden]{display:none}.toon-table-wrap{width:100%;min-width:0;overflow-x:auto}.toon-positions{margin-top:26px}.toon-table{width:100%;min-width:1120px;table-layout:fixed;border-collapse:collapse;font-size:13px}.toon-table td,.toon-table th{padding:7px 8px;border:1px solid currentColor;vertical-align:top;text-align:right;white-space:pre-line;overflow-wrap:anywhere}.toon-table th{white-space:normal}.toon-table td:first-child,.toon-table th:first-child,.toon-table td:last-child,.toon-table th:last-child{text-align:left}.toon-name,.toon-sub{display:block;max-width:280px;white-space:normal;overflow-wrap:anywhere}.toon-sub{margin-top:3px;color:var(--highlight-color);font-size:12px}.toon-actions{min-width:150px;white-space:normal!important}.toon-actions>*{display:inline-block;margin:0 8px 5px 0;white-space:nowrap}.toon-unpriced{opacity:.7}.toon-dialog{width:min(660px,calc(100vw - 28px));max-width:calc(100vw - 28px);padding:16px;border:1px solid currentColor;background:var(--main-background-color);color:var(--main-text-color)}.toon-dialog::backdrop{background:rgba(0,0,0,.55)}.toon-close{margin:0 0 18px;text-align:right}.toon-dialog h2{margin:0 0 8px;padding:0;border:0;color:inherit;font:bold 16px/1.4 monospace;text-align:left}.toon-dialog p{margin:0 0 12px;font:14px/1.45 monospace;text-align:left;overflow-wrap:anywhere}.toon-input{display:flex;gap:10px;align-items:center;margin:8px 0}.toon-input input{width:100%;min-width:0;padding:5px 7px;border:1px solid currentColor;border-radius:0;background:transparent;color:inherit;font:16px/1.4 monospace}.toon-dialog-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:14px}@media(max-width:700px){body>div:not(.modal){display:none}.toon-page{margin:14px 8px 40px;overflow-x:hidden}.toon-mobile-nav{display:block;margin-bottom:14px}.toon-toolbar{font-size:12px}.toon-table-wrap{overflow:visible}.toon-table{min-width:0;font-size:12px}.toon-table td,.toon-table th{padding:6px}.toon-table th:nth-child(3),.toon-table td:nth-child(3),.toon-table th:nth-child(5),.toon-table td:nth-child(5){display:none}.toon-table th:first-child{width:34%}.toon-table th:nth-child(2){width:22%}.toon-table th:nth-child(4){width:18%}.toon-table th:last-child{width:26%}.toon-name,.toon-sub{max-width:none}.toon-actions{min-width:0}.toon-actions>*{margin-right:6px}}
</style>
<%- include(`${partials}/scripts_onchain`, {scriptname: 'toonswap'}); -%>
</body>
</html>
